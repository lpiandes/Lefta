# Copy to `.env` in the repo root, then fill every required value.
# Never commit real secrets. Generate your own — do not paste examples into production.

# --- Required to boot the API ---
PORT=4000
JWT_SECRET=
# 32 random bytes as 64 hex chars (not all zeros):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Postgres (required). After `docker compose up -d`, use the user/password/db from docker-compose.yml:
DATABASE_URL=

# Browser origins allowed to call the API (comma-separated). Native apps send no Origin.
# Example for Expo web: http://localhost:8081
CORS_ORIGINS=

# --- Required to connect a real (or Plaid sandbox) bank ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_TRANSACTION_DAYS=90
PLAID_WEBHOOK_URL=

# --- Required to collect the 20% verified-recovery fee ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_APP_URL=

# --- Mobile (also copy EXPO_PUBLIC_API_URL into apps/mobile/.env) ---
EXPO_PUBLIC_API_URL=
